      "en": "Data: seats.aero",
      "zh": "数据：seats.aero",
      "when": "Any surface showing award data"
    },
    {
      "key": "result.none",
      "en": "No matches in the checked range.",
      "zh": "已查询的范围内没有匹配结果。",
      "when": "Complete checked scope only"
    },
    {
      "key": "result.partial",
      "en": "Results are incomplete.",
      "zh": "结果不完整。",
      "when": "Known partial"
    },
    {
      "key": "result.unknown",
      "en": "Coverage completeness is unknown.",
      "zh": "完整性未知。",
      "when": "Missing evidence / legacy cache"
    },
    {
      "key": "result.unmonitored",
      "en": "These routes are not monitored by the data source.",
      "zh": "数据源未监测这些机场对。",
      "when": "Explicit provider catalog evidence"
    },
    {
      "key": "result.min_partial",
      "en": "Lowest among the results retrieved",
