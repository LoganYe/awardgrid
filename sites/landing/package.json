{
  "name": "@awardgrid/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static public landing site on Vercel behind a Cloudflare proxy; no application API calls.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test cloudflare-public-proxy/worker.check.mjs",
    "test:public-proxy": "node --test cloudflare-public-proxy/worker.check.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@awardgrid/tokens": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.3"
  }
}
