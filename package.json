{
  "name": "awardgrid",
  "version": "0.2.0",
  "private": true,
  "description": "Private friends-only award-flight grid on seats.aero + travel-hacking-toolkit",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && pnpm --filter @awardgrid/core typecheck && pnpm --filter @awardgrid/ios typecheck",
    "typecheck:app": "tsc --noEmit",
    "test": "vitest run --passWithNoTests && pnpm --filter @awardgrid/core test && pnpm --filter @awardgrid/ios test",
    "test:app": "vitest run --passWithNoTests",
    "test:core": "pnpm --filter @awardgrid/core test",
    "test:watch": "vitest",
    "find": "tsx src/cli/find.ts",
    "admin": "tsx src/cli/admin.ts",
    "worker": "tsx src/cli/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "grid": "tsx src/cli/find.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:ui": "playwright test --ui",
    "mock:seats": "tsx scripts/mock-seatsaero.ts",
    "demo": "DEMO=1 tsx scripts/mock-seatsaero.ts",
    "test:ios": "pnpm --filter @awardgrid/ios test",
    "build:landing": "pnpm --filter @awardgrid/landing build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@awardgrid/core": "workspace:*",
    "@anthropic-ai/sdk": "^0.126.0",
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.1",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "node-cron": "^4.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
