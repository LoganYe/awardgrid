# ---- awardgrid runtime configuration (copy to .env; never commit .env) ----

# 32-byte hex key (64 hex chars) used for AES-256-GCM encryption of user API keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Server-side Anthropic key used ONLY for (a) the NL → QueryObject parser and (b) the Ask lane.
# seats.aero keys are NEVER configured here — every user adds their own in Settings.
ANTHROPIC_API_KEY=

# SQLite file (volume-mounted in Docker).
DATABASE_PATH=./data/runtime/awardgrid.db

# Public base URL used in Telegram messages / links.
APP_URL=http://localhost:3000

# Optional: Telegram bot for standing-query notifications (leave empty → mock transport).
TELEGRAM_BOT_TOKEN=

# Model overrides (defaults recorded in DECISIONS.md / ARCHITECTURE.md).
# AWARDGRID_PARSER_MODEL=
# AWARDGRID_ASK_MODEL=

# Tunables (defaults shown).
# CACHE_TTL_MINUTES=45
# ASK_DAILY_COST_CAP_USD=2
# ASK_TIMEOUT_MS=120000
# SEATS_AERO_DAILY_SOFT_LIMIT=950

# Development only: point the seats.aero client at the local mock (pnpm exec tsx scripts/mock-seatsaero.ts)
# so the whole app can be tried without a real key or any quota. Never set in production.
# SEATS_AERO_BASE_URL=http://127.0.0.1:3999/partnerapi/
# Set to "false" for plain-HTTP deployments (e.g. Tailscale without TLS); cookies are Secure by default in production.
# COOKIE_SECURE=false
# Set to "1" only behind a trusted reverse proxy (Cloudflare Access / Tailscale Serve) so X-Forwarded-For is used for login rate limits.
# TRUST_PROXY_HEADERS=1
