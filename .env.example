# ---- awardgrid runtime configuration (copy to .env; never commit .env) ----

# 32-byte hex key (64 hex chars) used for AES-256-GCM encryption of each user's seats.aero sign-in tokens and optional
# API keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Server-side Anthropic key used ONLY for (a) the NL → QueryObject parser and (b) the Ask lane.
# No seats.aero key is ever configured here, and none is pasted: every user connects their own seats.aero account in
# Settings through Login with Seats.aero.
ANTHROPIC_API_KEY=

# Login with Seats.aero: AwardGrid's OAuth client ID (not a secret; the client secret lives only in the token service,
# sites/auth). Unset: Settings says connecting is not set up here.
SEATS_OAUTH_CLIENT_ID=
# The token service the server exchanges and refreshes tokens through (default shown). In development point it at the
# mock (http://127.0.0.1:3999/oauth/seats) so fake tokens never reach the real one.
# SEATS_OAUTH_TOKEN_SERVICE_URL=https://awardgrid.dowhiz.com/oauth/seats
# Development / e2e only: seats.aero's consent page and the registered redirect URI, pointed at the mock and this app.
# SEATS_OAUTH_CONSENT_URL=http://127.0.0.1:3999/oauth2/consent
# SEATS_OAUTH_REDIRECT_URI=http://localhost:3000/api/seats/oauth/callback

# SQLite file (volume-mounted in Docker).
DATABASE_PATH=./data/runtime/awardgrid.db

# Public base URL used in Telegram messages / links.
APP_URL=http://localhost:3000

# Optional: Telegram bot for standing-query notifications (leave empty → mock transport).
TELEGRAM_BOT_TOKEN=

# Model overrides (defaults recorded in DECISIONS.md / ARCHITECTURE.md).
# AWARDGRID_PARSER_MODEL=
# AWARDGRID_ASK_MODEL=

# Tunables (defaults shown).
# CACHE_TTL_MINUTES=45                     # capped at 1440: seats.aero results are kept 24 hours at most
# ASK_DAILY_COST_CAP_USD=2
# ASK_TIMEOUT_MS=120000
# SEATS_AERO_DAILY_SOFT_LIMIT=950

# Development only: point the seats.aero client at the local mock (pnpm exec tsx scripts/mock-seatsaero.ts)
# so the whole app can be tried without a real key or any quota. Never set in production.
# SEATS_AERO_BASE_URL=http://127.0.0.1:3999/partnerapi/
# Set to "false" for plain-HTTP deployments (e.g. Tailscale without TLS); cookies are Secure by default in production.
# COOKIE_SECURE=false
# Set to "1" only behind a trusted reverse proxy (Cloudflare Access / Tailscale Serve) so X-Forwarded-For is used for login rate limits.
# TRUST_PROXY_HEADERS=1

# Telegram (optional). Create a bot with @BotFather; without a token the worker uses a mock transport.
# TELEGRAM_BOT_USERNAME=your_bot_name          # used for the t.me deep link; falls back to getMe
# TELEGRAM_API_BASE=https://api.telegram.org    # override only for tests/proxies
# AWARDGRID_DATA_DIR=./data/runtime             # mock-transport JSONL sink + worker state
